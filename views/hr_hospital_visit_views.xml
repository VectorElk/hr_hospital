<odoo>
    <record id="view_hr_hospital_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.visit.tree</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="planned_date"/>
                <field name="status"/>
                <field name="res_patient_id"/>
                <field name="res_doctor_id"/>
                <field name="condition_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Schedule">
                            <field name="date"/>
                            <field name="planned_date"/>
                            <field name="visit_time"/>
                            <field name="status"/>
                            <field name="active"/>
                        </group>
                        <group string="Participants">
                            <field name="res_patient_id"/>
                            <field name="res_doctor_id"/>
                            <field name="condition_id"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_visit_window" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
