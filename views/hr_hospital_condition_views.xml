<odoo>
    <record id="view_hr_hospital_condition_tree" model="ir.ui.view">
        <field name="name">hr.hospital.condition.tree</field>
        <field name="model">hr.hospital.condition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_condition_form" model="ir.ui.view">
        <field name="name">hr.hospital.condition.form</field>
        <field name="model">hr.hospital.condition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_condition_window" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">hr.hospital.condition</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_condition"
            name="Conditions"
            parent="hr_hospital_main_menu"
            action="action_hr_hospital_condition_window"
            sequence="300"/>
</odoo>

