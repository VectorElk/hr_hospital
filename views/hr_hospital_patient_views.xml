<odoo>
    <record id="hr_hospital_patient_views_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree ()</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="insurance_contact"/>
                <field name="family_doctor_id"/>
                <field name="res_visit_ids" widget="many2one_tags" options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_library_book_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form ()</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="insurance_contact"/>
                            <field name="emergency_contact"/>
                            <field name="family_doctor_id"/>
                        </group>
                        <group>
                            <field name="res_visit_ids"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient_window" model="ir.actions.act_window">
        <field name="name">patient</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_patient"
            action="action_hr_hospital_patient_window"
            parent="hr_hospital_main_menu"
            name="Patients" sequence="200"/>
</odoo>
