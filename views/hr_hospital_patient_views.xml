<odoo>
    <record id="hr_hospital_patient_views_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="blood_type"/>
                <field name="insurance_contact"/>
                <field name="insurance_policy_number"/>
                <field name="family_doctor_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Personal Info">
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="gender"/>
                            <field name="blood_type"/>
                        </group>
                        <group string="Contact &amp; Doctors">
                            <field name="insurance_contact"/>
                            <field name="insurance_policy_number"/>
                            <field name="emergency_contact"/>
                            <field name="personal_doctor_id"/>
                            <field name="family_doctor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctor History">
                            <field name="personal_doctor_history_ids">
                                <list>
                                    <field name="res_doctor_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visits">
                            <field name="res_visit_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="res_doctor_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient_window" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
