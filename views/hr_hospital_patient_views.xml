<odoo>
    <record id="hr_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="blood_type"/>
                <field name="insurance_contact"/>
                <field name="insurance_policy_number"/>
                <field name="family_doctor_id"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_quick_create_visit"
                            type="object"
                            string="Schedule Visit"
                            class="btn-primary"
                            invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_patient_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                invisible="not id">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group string="Personal Info">
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="gender"/>
                            <field name="blood_type"/>
                        </group>
                        <group string="Contact &amp; Doctors">
                            <field name="phone"/>
                            <field name="insurance_contact"/>
                            <field name="insurance_policy_number"/>
                            <field name="emergency_contact"/>
                            <field name="personal_doctor_id"/>
                            <field name="family_doctor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctor History">
                            <field name="personal_doctor_history_ids">
                                <list>
                                    <field name="res_doctor_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visits">
                            <field name="res_visit_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="res_doctor_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name" string="Full Name"
                       filter_domain="[('name', 'ilike', self)]"/>
                <field name="phone" string="Phone"
                       filter_domain="[('phone', 'ilike', self)]"/>
                <field name="personal_doctor_id"/>
                <field name="family_doctor_id"/>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_patient_window" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_hospital_patient_search"/>
    </record>
</odoo>
