<odoo noupdate="1">
    <record id="hr_hospital_condition_lupus" model="hr.hospital.condition">
        <field name="name">Lupus</field>
        <field name="description">House keeps suspecting it, but this time it is actually lupus.</field>
    </record>

    <record id="hr_hospital_condition_sarcoidosis" model="hr.hospital.condition">
        <field name="name">Sarcoidosis</field>
        <field name="description">Classic differential diagnosis in a difficult House-style case.</field>
    </record>

    <record id="hr_hospital_condition_vasculitis" model="hr.hospital.condition">
        <field name="name">Vasculitis</field>
        <field name="description">Another serious condition often considered during diagnostic puzzles.</field>
    </record>

    <record id="hr_hospital_doctor_category_intern" model="hr.hospital.doctor.category">
        <field name="name">Doctor Intern</field>
        <field name="sequence">10</field>
    </record>

    <record id="hr_hospital_doctor_category_specialist" model="hr.hospital.doctor.category">
        <field name="name">Doctor Specialist</field>
        <field name="sequence">20</field>
    </record>

    <record id="hr_hospital_doctor_category_highest" model="hr.hospital.doctor.category">
        <field name="name">Doctor Highest Category</field>
        <field name="sequence">30</field>
    </record>
</odoo>
