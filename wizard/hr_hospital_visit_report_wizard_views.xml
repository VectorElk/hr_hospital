<odoo>
    <record id="view_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.report.wizard.form</field>
        <field name="model">hr.hospital.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visit Report">
                <sheet>
                    <group>
                        <group>
                            <field name="doctor_ids" widget="many2many_tags"/>
                            <field name="patient_ids" widget="many2many_tags"/>
                            <field name="condition_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="only_completed"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_open_report" string="Open Report" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_visit_report_wizard_doctor_form" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_hospital.view_visit_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_hospital.model_hr_hospital_doctor"/>
        <field name="binding_view_types">form</field>
    </record>

    <record id="action_visit_report_wizard_doctor_list" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_hospital.view_visit_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_hospital.model_hr_hospital_doctor"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_visit_report_wizard_patient_form" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_hospital.view_visit_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_hospital.model_hr_hospital_patient"/>
        <field name="binding_view_types">form</field>
    </record>

    <record id="action_visit_report_wizard_patient_list" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_hospital.view_visit_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_hospital.model_hr_hospital_patient"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>

